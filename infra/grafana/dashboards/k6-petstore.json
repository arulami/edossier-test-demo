            "type": "influxdb",
            "uid": "influx-k6"
          },
          "query": "SELECT max(\"value\") FROM \"vus\" WHERE $timeFilter"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Virtual users and request rate",
      "description": "Load applied (VUs) against throughput achieved. Throughput flattening while VUs grow = saturation.",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-k6"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "time_series",
          "datasource": {
            "type": "influxdb",
            "uid": "influx-k6"
          },
          "query": "SELECT max(\"value\") FROM \"vus\" WHERE $timeFilter GROUP BY time($__interval) fill(none)",
          "alias": "virtual users"
        },
        {
          "refId": "B",
          "rawQuery": true,
          "resultFormat": "time_series",
          "datasource": {
            "type": "influxdb",
            "uid": "influx-k6"
          },
          "query": "SELECT count(\"value\") / ($__interval_ms / 1000) FROM \"http_reqs\" WHERE $timeFilter GROUP BY time($__interval) fill(0)",
          "alias": "requests / s"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "p95 response time per endpoint",
      "description": "Thresholds: overall p95 < 800 ms, findByStatus p95 < 500 ms, createPet p95 < 1000 ms.",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-k6"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
