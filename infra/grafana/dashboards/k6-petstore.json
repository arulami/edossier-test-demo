          "refId": "A",
          "rawQuery": true,
          "resultFormat": "time_series",
          "datasource": {
            "type": "influxdb",
            "uid": "influx-k6"
          },
          "query": "SELECT percentile(\"value\", 95) FROM \"http_req_duration\" WHERE $timeFilter GROUP BY time($__interval), \"endpoint\" fill(none)",
          "alias": "$tag_endpoint"
        }
      ]
    },
