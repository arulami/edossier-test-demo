          "resultFormat": "table",
          "datasource": {
            "type": "influxdb",
            "uid": "influx-k6"
          },
          "query": "SELECT percentile(\"value\", 95) FROM \"http_req_duration\" WHERE $timeFilter"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Peak virtual users",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-k6"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
